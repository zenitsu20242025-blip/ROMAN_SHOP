# Copy to .env for local development. On Render, set these in
# Settings -> Environment instead. NEVER commit a real .env file.

PORT=3000
SITE_URL=https://your-site.onrender.com

# --- Admin ---
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-long-random-string

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- CJ Dropshipping ---
CJ_API_KEY=
# Test first! While "true", CJ treats orders as sandbox orders (no real charge/shipping).
CJ_SANDBOX=true
# manual  = CJ order is created and waits for you to pay it in your CJ dashboard (default)
# balance = CJ order is paid automatically from your CJ balance
CJ_PAY_MODE=manual
# Warehouse country orders ship from: CN or US
CJ_FROM_COUNTRY=CN
# Used if CJ's shipping-method lookup fails
CJ_DEFAULT_LOGISTIC=CJPacket Ordinary
# Random secret for the tracking-sync cron URL
CRON_TOKEN=

# --- Payments ---
# manual = you confirm each payment in the admin panel (no gateway needed yet)
# stripe = hosted Stripe Checkout + webhook
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
