# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead —
# never commit a real .env file to GitHub.

PORT=3000

# Admin panel (/admin/login.html) — set a real password before deploying
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-random-string

# Supabase — durable database for products and orders (see README)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Payment gateway (2Checkout/Verifone or Payoneer Checkout) — fill in once approved
PAYMENT_API_KEY=

# CJ Dropshipping API token — from your CJ seller dashboard
CJ_API_KEY=

# Recommended: durable free database instead of the JSON file fallback
# (Supabase or MongoDB Atlas — both have no-expiry free tiers, unlike
# Render's own free Postgres, which is deleted after 30 days)
DATABASE_URL=
